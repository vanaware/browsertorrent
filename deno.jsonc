{
   "name": "@vanaware/browsertorrent-workspace",
   "version": "0.1.2#mv5nijrw",
   "repository": "https://github.com/vanaware/browsertorrent",
   "exports": "./scripts/esbuild.ts",
   "description": "A pure browser-based BitTorrent client implementation using WebRTC for peer-to-peer file sharing.",
   "author": "Vanaware",
   "license": "MIT",
   "workspace": [
     "./packages/core",
     "./packages/server",
     "./packages/example",
     "./packages/service-worker",
     "./packages/websocket-tracker"
   ],
   // ⚙️ Configurações Rigorosas do Compilador TypeScript (FASE 4)
   "compilerOptions": {
     "lib": ["dom", "dom.iterable", "dom.asynciterable", "esnext", "deno.ns", "deno.unstable"],
     "jsx": "react-jsx",
     "jsxImportSource": "preact",
     "strict": true,
     "noImplicitAny": true,
     "noUncheckedIndexedAccess": true
   },
   // 📦 Gerenciamento de Dependências
   "minimumDependencyAge": 60,
   "imports": {
     "@std/fs": "jsr:@std/fs@^1.0.24",
     "@std/path": "jsr:@std/path@^1.1.6",
     "@std/assert": "jsr:@std/assert@^1.0.19",
     "@std/testing": "jsr:@std/testing@^1.0.20",
     "@std/collections": "jsr:@std/collections@^1.3.0",
     "@vanaware/buildit": "jsr:@vanaware/buildit@^0.5.2",
     "@vanaware/workerdb": "jsr:@vanaware/workerdb@^0.5.1"
   },
  "catalog": {
    "esbuild": "^0.28.2"
  },
   "allowScripts": ["npm:esbuild@0.28.2"],
   // 🛠️ Scripts de Automação
   "tasks": {
     "test": "deno test --no-check -P",
     "lint": "deno lint",
     "fmt": "deno fmt",
     "check:all": "deno task --members check && deno check scripts/**/*.ts",
     "fmt:check": "deno fmt --check",
    "lint:fix": "deno lint --fix",
    "lint:doc:all": "deno task --members lint:doc",
    "tests": "deno task check:all && deno task lint && deno task fmt:check && deno task lint:doc:all && deno task test",
     "dev": "deno task --cwd packages/server dev",
    "start": "deno task --cwd packages/server start",
    "export": "deno run --allow-read --allow-write ./scripts/export.ts",
    "esbuild": "deno run -A ./scripts/esbuild.ts",
    "denobuild": "deno run --unstable-bundle -A ./scripts/denobuild.ts",
    "watch": "deno run -A ./scripts/watch.ts",
    "sanitize-version": "deno run -A ./scripts/sanitize-version.ts",
    "tag-version": "deno run -A ./scripts/tag-version.ts",
    "bump": "deno install --frozen=false && deno task esbuild dist noversion && deno task tag-version"
   },
   "nodeModulesDir": "auto",
   "vendor": true,
   "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": ["no-unused-vars", "no-explicit-any", "require-await"]
    },
    "include": [
      "scripts/**/*.ts",
      "packages/**/src/**/*.{ts,tsx}",
      "packages/**/tests/**/*test.ts"
    ],
    "exclude": [
      "packages/server/build/",
      "packages/example/public/"
    ]
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "net": true,
      "env": true,
      "sys": true,
      "run": true,
      "ffi": true,
      "import": true
    },
    "include": [
      "packages/**/tests/**/*test.ts"
    ],
    "exclude": [
      "packages/server/build/",
      "scripts/**/*.{ts,tsx}",
      "packages/**/src/**/*.{ts,tsx}"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "trailingCommas": "always",
    "json.trailingCommas": "never",
    "operatorPosition": "maintain",
    "jsx.bracketPosition": "sameLine",
    "jsx.forceNewLinesSurroundingContent": true,
    "jsx.multiLineParens": "always",
    "newLineKind": "lf",
    "include": [
      "scripts/**/*.ts",
      "packages/**/src/**/*.{ts,tsx}",
      "packages/**/tests/**/*test.ts"
    ],
    "exclude": [
      "packages/server/build/", 
      "packages/example/public/"
    ]
  },
  "unstable": ["bundle"],
  "exclude": [
      ".qwen/",
      ".vscode/",
      ".github/",
      "packages/server/build/", 
      "packages/example/public/",
      "vendor",
      "node_modules",
      "snapshots",
      "docs"
    ]
 }