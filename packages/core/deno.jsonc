{
  "name": "@vanaware/browsertorrent",
  "version": "1.0.3-h3",
  "exports": {
    ".": "./src/mod.ts",
    "./service-worker": "./src/service-worker/mod.ts",
    "./sw": "./src/service-worker/sw.ts",
    "./server": "./src/server/server.ts",
    "./torrent-generator": "./src/torrent-generator/mod.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "deno.unstable",
      "DOM",
      "webworker"
    ],
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert",
    "@std/fs": "jsr:@std/fs",
    "@std/path": "jsr:@std/path",
    "@std/http": "jsr:@std/http"
  },
  "tasks": {
    "test": "deno test -A tests/",
    "check": "deno check src/**/*.ts example/**/*.ts example/**/*.tsx tests/**/*.ts",
    "tests": "deno task check && deno task test",
    "serve": "deno run -A ./example/server.ts",
    "server": "deno run -A --watch ./example/server.ts",
    "trackers": "deno run -A ./example/test_trackers.ts"
  }
}
